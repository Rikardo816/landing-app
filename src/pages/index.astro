---
import Layout from '../layouts/Layout.astro';

const features = [
	{ icon: '⚡', title: 'Rápido', text: 'Contenido de ejemplo para mostrar una tarjeta de característica.' },
	{ icon: '🔒', title: 'Seguro', text: 'Texto de relleno. Esta web es solo una demo para probar widgets.' },
	{ icon: '📈', title: 'Escalable', text: 'Otro bloque genérico para rellenar la cuadrícula de servicios.' },
];

const plans = [
	{ name: 'Básico', price: '$0', items: ['1 proyecto', 'Soporte por email', 'Funciones esenciales'] },
	{ name: 'Pro', price: '$29', items: ['10 proyectos', 'Soporte prioritario', 'Integraciones'], featured: true },
	{ name: 'Empresa', price: 'A medida', items: ['Proyectos ilimitados', 'Soporte dedicado', 'SLA'] },
];

const faqs = [
	{ q: '¿Esto es un producto real?', a: 'No. Nimbus es una empresa ficticia; el sitio sirve para probar el widget de chat.' },
	{ q: '¿Dónde se configura el widget?', a: 'En el archivo widget.html de la raíz del repositorio.' },
	{ q: '¿Cómo se publican los cambios?', a: 'Cada commit en main dispara un build automático con GitHub Actions.' },
];
---

<Layout title="Nimbus | Sitio de demostración">
	<header>
		<div class="container nav">
			<a href="#inicio" class="logo">☁️ Nimbus</a>
			<nav>
				<a href="#caracteristicas">Características</a>
				<a href="#precios">Precios</a>
				<a href="#faq">FAQ</a>
			</nav>
		</div>
	</header>

	<main>
		<section id="inicio" class="hero">
			<div class="container">
				<span class="badge">Sitio de demostración</span>
				<h1>La plataforma ficticia para probar tu widget</h1>
				<p>Nimbus es una web dummy. Abre el chat en la esquina de la pantalla y pruébalo con contenido realista.</p>
				<div class="actions">
					<a href="#precios" class="btn">Ver planes</a>
					<a href="#faq" class="btn btn-ghost">Preguntas frecuentes</a>
				</div>
			</div>
		</section>

		<section id="caracteristicas" class="section">
			<div class="container">
				<h2>Características</h2>
				<div class="grid">
					{features.map((f) => (
						<article class="card">
							<div class="icon">{f.icon}</div>
							<h3>{f.title}</h3>
							<p>{f.text}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section id="precios" class="section alt">
			<div class="container">
				<h2>Precios</h2>
				<div class="grid">
					{plans.map((p) => (
						<article class:list={['card', 'plan', { featured: p.featured }]}>
							<h3>{p.name}</h3>
							<p class="price">{p.price}<span>{p.price.startsWith('$') ? '/mes' : ''}</span></p>
							<ul>
								{p.items.map((i) => <li>{i}</li>)}
							</ul>
							<a href="#inicio" class="btn">Elegir</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<section id="faq" class="section">
			<div class="container narrow">
				<h2>Preguntas frecuentes</h2>
				{faqs.map((f) => (
					<details>
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))}
			</div>
		</section>
	</main>

	<footer>
		<div class="container">
			<p>&copy; {new Date().getFullYear()} Nimbus (empresa ficticia). Sitio de pruebas.</p>
		</div>
	</footer>
</Layout>

<style>
	.container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 20px;
	}

	.narrow {
		max-width: 720px;
	}

	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgba(255, 255, 255, 0.9);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--color-border);
	}

	.nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		height: 64px;
	}

	.logo {
		font-weight: 800;
		font-size: 1.2rem;
		color: var(--color-text);
		text-decoration: none;
	}

	nav {
		display: flex;
		gap: 24px;
	}

	nav a {
		color: var(--color-muted);
		text-decoration: none;
		font-weight: 600;
	}

	nav a:hover {
		color: var(--color-primary);
	}

	.btn {
		display: inline-block;
		padding: 12px 22px;
		border-radius: 10px;
		background: var(--color-primary);
		color: #fff;
		font-weight: 600;
		text-decoration: none;
		transition: background 0.2s;
	}

	.btn:hover {
		background: var(--color-primary-dark);
	}

	.btn-ghost {
		background: transparent;
		color: var(--color-primary);
		border: 1px solid var(--color-primary);
	}

	.btn-ghost:hover {
		background: var(--color-surface);
	}

	.hero {
		padding: 120px 0 100px;
		text-align: center;
		background: linear-gradient(180deg, var(--color-surface) 0%, var(--color-bg) 100%);
	}

	.badge {
		display: inline-block;
		padding: 4px 12px;
		border-radius: 999px;
		background: #e0e7ff;
		color: var(--color-primary-dark);
		font-size: 0.85rem;
		font-weight: 600;
	}

	.hero h1 {
		font-size: clamp(2rem, 5vw, 3.2rem);
		max-width: 760px;
		margin: 20px auto;
	}

	.hero p {
		font-size: 1.15rem;
		color: var(--color-muted);
		max-width: 620px;
		margin: 0 auto 32px;
	}

	.actions {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 12px;
	}

	.section {
		padding: 80px 0;
	}

	.section.alt {
		background: var(--color-surface);
	}

	.section h2 {
		text-align: center;
		font-size: 2rem;
		margin: 0 0 48px;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 24px;
	}

	.card {
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		padding: 28px;
	}

	.card h3 {
		margin: 12px 0 8px;
	}

	.card p {
		color: var(--color-muted);
		margin: 0;
	}

	.icon {
		font-size: 2rem;
	}

	.plan {
		display: flex;
		flex-direction: column;
	}

	.plan.featured {
		border: 2px solid var(--color-primary);
	}

	.price {
		font-size: 2rem;
		font-weight: 800;
		color: var(--color-text) !important;
		margin: 8px 0 16px !important;
	}

	.price span {
		font-size: 1rem;
		font-weight: 400;
		color: var(--color-muted);
	}

	.plan ul {
		padding-left: 20px;
		margin: 0 0 24px;
		flex: 1;
	}

	.plan .btn {
		text-align: center;
	}

	details {
		border: 1px solid var(--color-border);
		border-radius: 12px;
		padding: 16px 20px;
		margin-bottom: 12px;
	}

	summary {
		font-weight: 600;
		cursor: pointer;
	}

	details p {
		color: var(--color-muted);
		margin: 12px 0 0;
	}

	footer {
		padding: 32px 0;
		text-align: center;
		color: var(--color-muted);
		border-top: 1px solid var(--color-border);
	}

	@media (max-width: 600px) {
		nav {
			gap: 14px;
			font-size: 0.9rem;
		}

		.hero {
			padding: 80px 0 64px;
		}

		.section {
			padding: 56px 0;
		}
	}
</style>
